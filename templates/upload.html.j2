<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>loop-cr-review</title>
<style>
  :root {
    --ink:#3F454A; --muted:#5a6b82; --line:#dde3ee; --bg:#eef1f6; --blue:#1A6FC6;
    --card:#fff; --input-bg:#fff; --btn-sec-bg:#eaf1fb; --btn-sec-hover:#dbe8fb;
    --disc-bg:#fff6f3; --disc-border:#f0b7a6; --disc-ink:#7a2318; --disc-b:#a12626;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --ink:#e6eaf0; --muted:#a8b4c4; --line:#3a4556; --bg:#12161c; --blue:#4d9eef;
      --card:#1c2330; --input-bg:#161c27; --btn-sec-bg:#243044; --btn-sec-hover:#2c3a52;
      --disc-bg:#2a1c1a; --disc-border:#8a4a3c; --disc-ink:#f0c4bc; --disc-b:#f0a090;
    }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .wrap { max-width: 660px; margin: 0 auto; padding: 28px 20px 56px; }
  .brand { height: 44px; width:auto; display:block; margin: 8px 0 4px; }
  h1 { font-size: 15px; color: var(--muted); font-weight: 600; margin: 0 0 20px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:22px; }
  label { display:block; font-weight:600; margin: 16px 0 6px; }
  label.first { margin-top: 0; }
  input[type=file], select, input[type=number], input[type=text] {
    width:100%; padding:9px 10px; border:1px solid var(--line);
    border-radius:9px; font-size:14px; background:var(--input-bg); color:var(--ink); }
  .row { display:flex; gap:16px; } .row > div { flex:1; }
  .hint { font-weight:400; color:var(--muted); font-size:12px; margin-top:4px; }
  .check { display:flex; align-items:center; gap:8px; margin-top:16px; font-weight:600; }
  .check input { width:auto; }
  button { margin-top:22px; width:100%; padding:12px; border:0; border-radius:10px;
           background:var(--blue); color:#fff; font-size:15px; font-weight:600; cursor:pointer; }
  button:hover { background:#155aa3; }
  .btn-sec { margin:8px 0 0; width:auto; padding:7px 12px; font-size:13px;
             background:var(--btn-sec-bg); color:var(--blue); }
  .btn-sec:hover { background:var(--btn-sec-hover); }
  .disclaimer { margin:18px 0 0; padding:12px 14px; border-radius:10px;
                background:var(--disc-bg); border:1px solid var(--disc-border);
                border-left:4px solid #c0392b; font-size:13px; color:var(--disc-ink); }
  .disclaimer b { color:var(--disc-b); }
  .foot { margin-top:22px; font-size:12px; color:var(--muted); text-align:center; }
  .foot a { color:var(--blue); text-decoration:none; }
  fieldset { border:1px solid var(--line); border-radius:10px; margin:16px 0 0; padding:12px 14px 16px; }
  legend { font-weight:600; font-size:13px; padding:0 6px; color:var(--muted); }
  table.slots { width:100%; border-collapse:collapse; margin-top:8px; }
  table.slots th { text-align:left; font-size:12px; color:var(--muted); font-weight:600; padding:0 6px 4px; }
  table.slots td { padding:3px 6px; }
  table.slots input { padding:7px 8px; }
  .slot-h { width:56px; }
  .rm { background:#fbeaea; color:#a12626; border:0; border-radius:8px; padding:7px 10px;
        font-weight:700; cursor:pointer; width:auto; margin:0; }
  .rm:hover { background:#f6d6d6; }
  .hidden { display:none; }
  .progress-card { margin-top:16px; padding:16px; border:1px solid var(--line);
                   border-radius:10px; background:var(--card); }
  .progress-head { display:flex; justify-content:space-between; gap:12px;
                   font-size:13px; font-weight:600; }
  .progress-track { height:10px; margin-top:10px; background:var(--line);
                    border-radius:999px; overflow:hidden; }
  .progress-bar { height:100%; width:0; background:var(--blue); transition:width .2s ease; }
  .progress-error { color:var(--disc-b); font-size:13px; margin-top:10px; }
</style>
</head>
<body>
<div class="wrap">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset="{{ url_for('static', filename='logo-readme-dark.svg') }}">
    <img class="brand" src="{{ url_for('static', filename='logo-horizontal.svg') }}" alt="loop-cr-review">
  </picture>
  <h1>{% trans %}Loop-aware Carb-Ratio Review · CR assessment from CamAPS FX data{% endtrans %}</h1>
  <p class="hint" style="margin:0 0 14px">{% trans %}Designed and tested <b>only for CamAPS FX Auto Mode</b> (Glooko export). Other closed-loop systems: see README.{% endtrans %}</p>

  <form class="card" action="{{ url_for('report') }}" method="post" enctype="multipart/form-data">
    <label class="first" for="export">{% trans %}Export (ZIP or CSV){% endtrans %}</label>
    <input id="export" type="file" name="export" accept=".zip,.csv,application/zip,text/csv" required>
    <div class="hint">{% trans %}Glooko ZIP, Nightscout ZIP (entries.json + treatments.json), or a glucose CSV from LibreView or Dexcom Clarity. Processed in memory only, then deleted{% endtrans %}</div>

    <div class="row">
      <div>
        <label for="lang">{% trans %}Language{% endtrans %}</label>
        <select id="lang" name="lang" onchange="location.search='?lang='+this.value">
          <option value="de" {% if lang == 'de' %}selected{% endif %}>Deutsch</option>
          <option value="en" {% if lang == 'en' %}selected{% endif %}>English</option>
        </select>
        <div class="hint">{% trans %}UI and report language (default German).{% endtrans %}</div>
      </div>
      <div>
        <label for="window_hours">{% trans %}Meal window (h){% endtrans %}</label>
        <input id="window_hours" type="number" name="window_hours" value="4" min="0.5" max="12" step="0.5">
        <div class="hint">{% trans %}Postprandial window (default 4).{% endtrans %}</div>
      </div>
    </div>

    
    <div class="row">
      <div>
        <label for="date_from">{% trans %}From{% endtrans %}</label>
        <input id="date_from" type="date" name="date_from">
      </div>
      <div>
        <label for="date_to">{% trans %}To{% endtrans %}</label>
        <input id="date_to" type="date" name="date_to">
        <div class="hint" id="span-hint">{% trans %}Choose a file to see the full range. Nothing is stored on the server.{% endtrans %}</div>
      </div>
    </div>
    <label class="check"><input type="checkbox" name="assume_camaps"> {% trans %}Force CamAPS assessment (Part 2) for Nightscout / other sources{% endtrans %}</label>
    <label class="check"><input type="checkbox" name="daily"> {% trans %}Attach daily overview{% endtrans %}</label>
    <label class="check"><input type="checkbox" name="dark_charts"> {% trans %}Also render dark-theme charts (AGP, slots, daily){% endtrans %}</label>

    <fieldset>
      <legend>{% trans %}Slots (time-of-day windows){% endtrans %}</legend>
      <label class="first" for="slots_mode">{% trans %}Source{% endtrans %}</label>
      <select id="slots_mode" name="slots_mode" onchange="slotMode(this.value)">
        <option value="default" selected>{% trans %}Default (05–10 / 11–15 / 17–22){% endtrans %}</option>
        <option value="extended">{% trans %}Extended (05–11 / 11–15 / 15–22){% endtrans %}</option>
        <option value="with_snacks">{% trans %}With snacks (snacks 09–11 and 15–17){% endtrans %}</option>
        <option value="fields">{% trans %}Custom fields{% endtrans %}</option>
        <option value="json">{% trans %}JSON file{% endtrans %}</option>
      </select>
      <div class="hint">{% trans %}Profiles only set the time-of-day windows, not the CR calculation.{% endtrans %}</div>

      <div id="slots-fields" class="hidden">
        <table class="slots">
          <thead><tr><th>{% trans %}Label{% endtrans %}</th><th>{% trans %}Start{% endtrans %}</th><th>{% trans %}End{% endtrans %}</th><th></th></tr></thead>
          <tbody id="slot-rows"></tbody>
        </table>
        <button type="button" class="btn-sec" onclick="addRow()">+ {% trans %}Row{% endtrans %}</button>
        <div class="hint">{% trans %}Hours 0–24, start &lt; end, no overlap. The catch-all slot “Other” is added automatically.{% endtrans %}</div>
      </div>

      <div id="slots-json" class="hidden">
        <label for="slots">{% trans %}Slots file (JSON){% endtrans %}</label>
        <input id="slots" type="file" name="slots" accept=".json">
      </div>
    </fieldset>

    <button id="submit-btn" type="submit">{% trans %}Create report{% endtrans %}</button>

    <div id="progress-card" class="progress-card hidden" aria-live="polite">
      <div class="progress-head">
        <span id="progress-stage">{% trans %}Preparing analysis…{% endtrans %}</span>
        <span id="progress-percent">0 %</span>
      </div>
      <div class="progress-track"><div id="progress-bar" class="progress-bar"></div></div>
      <div id="progress-error" class="progress-error hidden"></div>
    </div>

    <div class="disclaimer">
      {% trans %}<b>⚠︎ Not a medical device, no dosing recommendation.</b>
      Statistical analysis of existing CGM/pump data as a basis for discussions
      with the care team — no diagnosis, no treatment decision.{% endtrans %}
      <br><br>
      {% trans %}<b>CamAPS FX (Auto Mode) only.</b>
      The method relies on modulated basal as the loop signal. Other AID systems
      (e.g. Control-IQ, Omnipod&nbsp;5, AndroidAPS) are not supported;
      results would not be valid there.{% endtrans %}
      <br><br>
      {% trans %}<b>Homelab / private.</b>
      While the analysis runs, the upload and the finished report sit in a private
      folder in the system temp area. The export itself is deleted as soon
      as the report exists; the report follows after 15 minutes at the latest.
      Until then it stays open so you can still save it. No public hosting, no archive.{% endtrans %}
    </div>
  </form>

  <div class="foot">
    Open Source (AGPL-3.0-or-later){% if version %} &middot; {{ version }}{% endif %} &middot;
    <a href="{{ repo }}" target="_blank" rel="noopener noreferrer">{{ repo.replace('https://','') }}</a>
  </div>
</div>

<script>
  var DEFAULTS = {{ slot_defaults | tojson }};
  function row(label, s, e) {
    var tr = document.createElement("tr");
    tr.innerHTML =
      '<td><input type="text" name="slot_label" value="'+label+'"></td>' +
      '<td><input class="slot-h" type="number" name="slot_start" min="0" max="23" value="'+s+'"></td>' +
      '<td><input class="slot-h" type="number" name="slot_end" min="1" max="24" value="'+e+'"></td>' +
      '<td><button type="button" class="rm" onclick="this.closest(\'tr\').remove()">&times;</button></td>';
    return tr;
  }
  function addRow(){ document.getElementById("slot-rows").appendChild(row("",8,10)); }
  function fillDefaults(){
    var b = document.getElementById("slot-rows"); b.innerHTML="";
    DEFAULTS.forEach(function(d){ b.appendChild(row(d[0],d[1],d[2])); });
  }

  var form = document.querySelector("form.card");
  var submitBtn = document.getElementById("submit-btn");
  var progressCard = document.getElementById("progress-card");
  var progressBar = document.getElementById("progress-bar");
  var progressStage = document.getElementById("progress-stage");
  var progressPercent = document.getElementById("progress-percent");
  var progressError = document.getElementById("progress-error");
  var ANALYZE_URL = "{{ url_for('analyze') }}";
  var PROGRESS_URL = "{{ url_for('progress', job_id='JOB') }}";
  var RESULT_URL = "{{ url_for('result', job_id='JOB') }}";

  function progressText(stage) {
    var labels = {
      queued: "{% trans %}Queued…{% endtrans %}",
      read: "{% trans %}Reading data…{% endtrans %}",
      meals: "{% trans %}Analysing meals…{% endtrans %}",
      analysis: "{% trans %}Analysing slots…{% endtrans %}",
      charts: "{% trans %}Rendering charts…{% endtrans %}",
      daily: "{% trans %}Rendering daily charts…{% endtrans %}",
      report: "{% trans %}Preparing report…{% endtrans %}",
      render: "{% trans %}Rendering report…{% endtrans %}",
      done: "{% trans %}Analysis complete{% endtrans %}",
      error: "{% trans %}Analysis failed{% endtrans %}"
    };
    var key = String(stage || "").split(" ")[0];
    var label = labels[key] || "{% trans %}Analysing…{% endtrans %}";
    if (key === "daily" && String(stage).length > key.length) {
      label += " " + String(stage).slice(key.length + 1);
    }
    return label;
  }

  function showProgress(data) {
    var pct = Math.max(0, Math.min(100, Number(data.percent) || 0));
    progressBar.style.width = pct + "%";
    progressPercent.textContent = pct + " %";
    progressStage.textContent = progressText(data.stage);
  }

  function showError(message) {
    progressError.textContent = message || "{% trans %}Could not build report.{% endtrans %}";
    progressError.classList.remove("hidden");
    progressStage.textContent = progressText("error");
  }

  if (form) {
    form.addEventListener("submit", function(ev) {
      ev.preventDefault();
      progressCard.classList.remove("hidden");
      progressError.classList.add("hidden");
      submitBtn.disabled = true;
      submitBtn.textContent = "{% trans %}Analysing…{% endtrans %}";
      showProgress({stage:"queued", percent:0});

      fetch(ANALYZE_URL, {method:"POST", body:new FormData(form)})
        .then(function(r) {
          return r.json().catch(function(){ return {}; }).then(function(j) {
            if (!r.ok) throw new Error(j.error || "{% trans %}Could not start analysis.{% endtrans %}");
            return j;
          });
        })
        .then(function(j) {
          return new Promise(function(resolve, reject) {
            var poll = function() {
              fetch(PROGRESS_URL.replace("JOB", j.job_id), {cache:"no-store"})
                .then(function(r) {
                  return r.json().catch(function(){ return {}; }).then(function(d) {
                    if (!r.ok) throw new Error(d.error || "{% trans %}Progress unavailable.{% endtrans %}");
                    return d;
                  });
                })
                .then(function(d) {
                  showProgress(d);
                  if (d.state === "done") {
                    resolve(j.job_id);
                  } else if (d.state === "error") {
                    reject(new Error(d.error || "{% trans %}Could not build report.{% endtrans %}"));
                  } else {
                    window.setTimeout(poll, 250);
                  }
                })
                .catch(reject);
            };
            poll();
          });
        })
        .then(function(jobId) {
          window.location.href = RESULT_URL.replace("JOB", jobId);
          // With "download" the browser saves the file and stays on this page, so
          // no navigation resets the form: without this the box would keep saying
          // the analysis is running and the button would stay disabled.
          window.setTimeout(function() {
            showProgress({percent: 100, stage: "done"});
            submitBtn.disabled = false;
            submitBtn.textContent = "{% trans %}Create report{% endtrans %}";
          }, 1500);
        })
        .catch(function(err) {
          showError(err.message);
          submitBtn.disabled = false;
          submitBtn.textContent = "{% trans %}Create report{% endtrans %}";
        });
    });
  }

  var exportInput = document.getElementById("export");
  if (exportInput) {
    var dateFrom = document.getElementById("date_from");
    var dateTo = document.getElementById("date_to");

    // The range belongs to one particular file. Leaving the old values in place
    // while the new ones are fetched - or after the fetch failed - means the
    // next report is built for a period the new export may not even cover.
    function clearRange(){ dateFrom.value = ""; dateTo.value = ""; }

    exportInput.addEventListener("change", function(){
      var f = this.files && this.files[0];
      var hint = document.getElementById("span-hint");
      clearRange();
      if (!f) { hint.textContent = ""; return; }
      var fd = new FormData();
      fd.append("export", f);
      hint.textContent = "...";
      submitBtn.disabled = true;
      fetch("{{ url_for('span') }}", {method:"POST", body:fd})
        .then(function(r){
          return r.text().then(function(t){
            var j = null;
            try { j = JSON.parse(t); } catch (e) {}
            return {ok:r.ok, j:j, status:r.status};
          });
        })
        .then(function(x){
          if (!x.ok) {
            hint.textContent = (x.j && x.j.error) || ("error " + x.status);
            return;
          }
          dateFrom.value = x.j.from;
          dateTo.value = x.j.to;
          hint.textContent = x.j.source + ": " + x.j.days + " d";
        })
        .catch(function(err){ hint.textContent = "error: " + (err && err.message ? err.message : "network"); })
        .then(function(){ submitBtn.disabled = false; });
    });

    // Coming back with the browser restores the form from the cache, including
    // a range that was read from the file chosen before.
    window.addEventListener("pageshow", function(e){
      if (e.persisted) { clearRange(); document.getElementById("span-hint").textContent = ""; }
    });
  }
  function slotMode(m){
    document.getElementById("slots-fields").classList.toggle("hidden", m!=="fields");
    document.getElementById("slots-json").classList.toggle("hidden", m!=="json");
    if (m==="fields" && !document.getElementById("slot-rows").children.length) fillDefaults();
  }
</script>
</body>
</html>
