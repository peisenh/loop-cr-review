<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ tool }} — {{ name }}</title>
<style>
:root {
  --ink:#1a2233; --muted:#5a6b82; --line:#dde3ee; --bg:#eef1f6; --card:#fff;
  --gen:#8a97a8; --link:#5b8def; --track:#eef1f6; --slot-bg:#fafbfd;
  --disc-bg:#fff6f3; --disc-border:#f0b7a6; --disc-ink:#7a2318; --disc-b:#a12626;
  --weak-bg:#fff3e8; --strong-bg:#fdeaea; --ok-bg:#eef8ef;
  --method-bg:#f7f9fc; --method-border:#c5d0e0; --method-b:#1c4ea8;
  --eff-bg:#f4f7ff; --eff-border:#cdddff; --code-bg:#eef1f6;
  --lowconf-a:#f2f2f2; --lowconf-b:#e8e8e8; --lowconf-ink:#7a6a2a;
  --lc-tag-bg:#f5e6a8; --lc-tag-ink:#6a5a18; --meta-low:#a5541b;
  --tag-sea-bg:#e7efff; --tag-sea:#1c4ea8; --tag-cr-bg:#fdeaea; --tag-cr:#a12626;
  --tag-fp-bg:#fff3e8; --tag-fp:#a5541b; --tag-obs-bg:#eef8ef; --tag-obs:#2b7a34;
  --brand:#3F454A;
}
@media (prefers-color-scheme: dark) {
  :root {
    --ink:#e8ecf2; --muted:#a8b4c4; --line:#3a4556; --bg:#12161c; --card:#1c2330;
    --gen:#8a97a8; --link:#7eb0ff; --track:#2a3344; --slot-bg:#1a2130;
    --disc-bg:#2a1c1a; --disc-border:#8a4a3c; --disc-ink:#f0c4bc; --disc-b:#f0a090;
    --weak-bg:#3a2e22; --strong-bg:#3a2226; --ok-bg:#1e3224;
    --method-bg:#1a2130; --method-border:#3a4a60; --method-b:#7eb0ff;
    --eff-bg:#1a2438; --eff-border:#3a5080; --code-bg:#2a3344;
    --lowconf-a:#2a2a2a; --lowconf-b:#353535; --lowconf-ink:#d4c48a;
    --lc-tag-bg:#5a4e28; --lc-tag-ink:#f5e6a8; --meta-low:#e8a06a;
    --tag-sea-bg:#1e2e4a; --tag-sea:#8bb4ff; --tag-cr-bg:#4a2828; --tag-cr:#f0a0a0;
    --tag-fp-bg:#3a2e22; --tag-fp:#e0b080; --tag-obs-bg:#1e3224; --tag-obs:#90d0a0;
    --brand:#e8ecf2;
  }
}
.chart-wrap { margin: 0 }
.chart-wrap img { width: 100%; border-radius: 8px; display: block }
.chart-wrap .chart-dark { display: none }
@media (prefers-color-scheme: dark) {
  .chart-wrap .chart-light { display: none }
  .chart-wrap .chart-dark { display: block }
  .dailyrow:not(:has(.chart-dark)) .chart-light { display: block }
}
@media print {
  .card { break-inside: avoid }
  .chart-wrap .chart-dark { display: none !important }
  .chart-wrap .chart-light { display: block !important }
  :root {
    --ink:#1a2233; --muted:#5a6b82; --line:#dde3ee; --bg:#fff; --card:#fff;
    --gen:#8a97a8; --link:#5b8def; --track:#eef1f6; --slot-bg:#fafbfd;
    --disc-bg:#fff6f3; --disc-border:#f0b7a6; --disc-ink:#7a2318; --disc-b:#a12626;
    --weak-bg:#fff3e8; --strong-bg:#fdeaea; --ok-bg:#eef8ef;
    --method-bg:#f7f9fc; --method-border:#c5d0e0; --method-b:#1c4ea8;
    --eff-bg:#f4f7ff; --eff-border:#cdddff; --code-bg:#eef1f6;
    --lowconf-a:#f2f2f2; --lowconf-b:#e8e8e8; --lowconf-ink:#7a6a2a;
    --lc-tag-bg:#f5e6a8; --lc-tag-ink:#6a5a18; --meta-low:#a5541b;
    --tag-sea-bg:#e7efff; --tag-sea:#1c4ea8; --tag-cr-bg:#fdeaea; --tag-cr:#a12626;
    --tag-fp-bg:#fff3e8; --tag-fp:#a5541b; --tag-obs-bg:#eef8ef; --tag-obs:#2b7a34;
    --brand:#3F454A;
  }
  body { background: #fff !important; }
}
body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; margin: 0; background: var(--bg); color: var(--ink) }
.wrap { max-width: 900px; margin: 0 auto; padding: 22px }
h1 { font-size: 20px; margin: 0 }
.tool { font-size: 12px; color: var(--muted); letter-spacing: .04em; text-transform: uppercase; margin: 0 0 2px }
.brand { height: 34px; width: auto; display: block; margin: 0 0 8px; color: var(--brand) }
.sub { color: var(--muted); font-size: 13px; margin: 2px 0 4px }
.gen { color: var(--gen); font-size: 11px; margin: 0 0 16px }
.gen a { color: var(--link); text-decoration: none }
.disclaimer { background: var(--disc-bg); border: 1px solid var(--disc-border); border-left: 4px solid #c0392b;
  border-radius: 10px; padding: 12px 14px; margin-bottom: 16px; font-size: 12px; color: var(--disc-ink); line-height: 1.5 }
.disclaimer b { color: var(--disc-b) }
.part { margin: 22px 0 10px; padding: 0 2px }
.part h2 { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; margin: 0;
  color: var(--muted); border-bottom: 2px solid var(--line); padding-bottom: 5px }
.part-sub { font-size: 11.5px; color: var(--gen); margin-top: 5px; line-height: 1.45 }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; margin-bottom: 14px }
h2 { font-size: 14px; margin: 0 0 10px }
.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px }
.kpi { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px }
.kpi .v { font-size: 21px; font-weight: 700 }
.kpi .l { font-size: 10.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em }
.row { display: flex; align-items: center; gap: 10px; margin: 5px 0; font-size: 13px }
.row span { width: 150px }
.row b { width: 52px; text-align: right }
.track { flex: 1; height: 12px; background: var(--track); border-radius: 6px; overflow: hidden }
.fill { height: 100% }
table { width: 100%; border-collapse: collapse; font-size: 12px }
th, td { text-align: left; padding: 5px 7px; border-bottom: 1px solid var(--line) }
th { color: var(--muted); font-weight: 600 }
tr.weak { background: var(--weak-bg) } tr.strong { background: var(--strong-bg) } tr.ok { background: var(--ok-bg) }
tr.lowconf { background: repeating-linear-gradient(135deg, var(--lowconf-a), var(--lowconf-a) 8px, var(--lowconf-b) 8px, var(--lowconf-b) 16px);
  outline: 1px dashed #a0893a; outline-offset: -1px }
tr.lowconf td:last-child { color: var(--lowconf-ink); font-weight: 600 }
.slot.lowconf { background: repeating-linear-gradient(135deg, var(--slot-bg), var(--slot-bg) 8px, var(--lowconf-b) 8px, var(--lowconf-b) 16px);
  border-right: 3px dashed #a0893a }
.lc-tag { display: inline-block; font-size: 10px; font-weight: 600; padding: 1px 6px; border-radius: 8px;
  margin-left: 6px; background: var(--lc-tag-bg); color: var(--lc-tag-ink); vertical-align: middle }
.spread { font-size: 11px; font-weight: 400; color: var(--gen); margin-top: 3px; line-height: 1.35 }
.stab { font-size: 11px; font-weight: 400; color: var(--muted); margin-top: 3px; line-height: 1.35 }
.meta { font-size: 11px; font-weight: 400; color: var(--muted); margin-top: 3px; line-height: 1.35 }
.meta.low { color: var(--meta-low); font-weight: 600 }
.d4low { color: var(--disc-b) }
.fewd { color: var(--meta-low); font-weight: 600 }
.slot { border-left: 4px solid #ccc; padding: 9px 13px; margin: 9px 0; border-radius: 0 8px 8px 0; background: var(--slot-bg) }
.slot.strong { border-color: #c0392b } .slot.weak { border-color: #e0913a } .slot.ok { border-color: #3a9b46 }
.slot h3 { margin: 0 0 3px; font-size: 13.5px }
.mline { font-size: 11.5px; color: var(--muted); margin: 3px 0 4px }
.mline b { color: var(--ink) }
.lever { font-size: 12.5px; margin: 3px 0 }
.lever .tag { display: inline-block; font-size: 10.5px; font-weight: 600; padding: 1px 7px; border-radius: 10px; margin-right: 6px }
.t-sea { background: var(--tag-sea-bg); color: var(--tag-sea) } .t-cr { background: var(--tag-cr-bg); color: var(--tag-cr) }
.t-fp { background: var(--tag-fp-bg); color: var(--tag-fp) } .t-obs { background: var(--tag-obs-bg); color: var(--tag-obs) }
.eff { background: var(--eff-bg); border: 1px solid var(--eff-border); border-radius: 10px; padding: 12px 14px; font-size: 12px; line-height: 1.6 }
.methodbox { background: var(--method-bg); border: 1px solid var(--method-border); border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; font-size: 12px; line-height: 1.55; color: var(--ink) }
.methodbox b { color: var(--method-b) }
.methodbox code { font-family: monospace; background: var(--code-bg); color: var(--ink); padding: 1px 4px; border-radius: 4px; font-size: 11px }
.eff b { color: var(--method-b) }
.eff code { font-family: monospace; background: var(--code-bg); color: var(--ink); padding: 1px 4px; border-radius: 4px }
.dailyrow { margin: 3px 0 }
.dailyrow img { width: 100%; border-radius: 6px; display: block }
@media print { .dailyrow { break-inside: avoid } }
img { width: 100%; border-radius: 8px }
.note { font-size: 11.5px; color: #5a6b82; line-height: 1.5 }
.tag { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 10px; margin-right: 5px }
.tw { background: var(--tag-fp-bg); color: var(--tag-fp) } .ts { background: var(--tag-cr-bg); color: var(--tag-cr) } .to { background: var(--tag-obs-bg); color: var(--tag-obs) }
</style>
</head>
