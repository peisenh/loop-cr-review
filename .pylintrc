[MAIN]
max-line-length=120
# Data reading/analysis/assembly functions legitimately hold a few more locals
# (analyze_meals, daily_charts, build_context assemble the whole report context).
# The remaining outliers are the reader/context boundaries (read_libreview,
# read_nightscout, build_context, slot_norm_curves_chart). They are wide by
# nature — one place that maps many fields — not deeply nested. Splitting them
# would spread one mapping over several functions without making it clearer.
max-locals=50
# i18n infrastructure (gettext setup, catalogs), the reusable generate_report()
# entry point (shared by the CLI and a web front-end) and the dark-mode chart
# variants, the decision-stability bootstrap and the day spread pushed the
# Since the split into lcr/ no module needs the old, repeatedly raised limit.
max-module-lines=1000
# generate_report() mirrors the CLI options (lang/window/daily/slots/template)
# as keyword arguments (lang/window/daily/dark/slots/template); that is the
# natural arity of the front-end boundary, not accidental growth.
# The analysis/chart functions take the same number of data inputs.
# generate_report is the front-end boundary: every option the CLI, the web app
# and the GUI can set arrives here as a keyword. That is its arity, not growth.
max-args=11
max-positional-arguments=11
# N_ is the conventional gettext_noop marker for deferred translation.
good-names=N_

[MESSAGES CONTROL]
disable=missing-module-docstring,
        missing-class-docstring
max-statements=72
max-branches=22
# slot_headline is a lookup table written as branches: one return per shape.
max-returns=8
