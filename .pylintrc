[MAIN]
max-line-length=120
# Data reading/analysis/assembly functions legitimately hold a few more locals.
max-locals=22
# i18n infrastructure (gettext setup, catalogs) plus the reusable
# generate_report() entry point (shared by the CLI and a web front-end)
# pushed the single file past 1200.
max-module-lines=1250
# generate_report() mirrors the CLI options (lang/window/daily/slots/template)
# as keyword arguments; six is the natural arity of that front-end boundary.
max-args=6
# N_ is the conventional gettext_noop marker for deferred translation.
good-names=N_

[MESSAGES CONTROL]
disable=missing-module-docstring,
        missing-class-docstring
