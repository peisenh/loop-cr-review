#: templates/report.html.j2:139
msgid "Ambulatory Glucose Profile &amp; CR Assessment"
msgstr "Ambulatory Glucose Profile &amp; CR-Beurteilung"

#: templates/report.html.j2:140
#, python-format
msgid "%(days)s days"
msgstr "%(days)s Tage"

#: templates/report.html.j2:140
msgid "sensor wear"
msgstr "Sensor-Wear"

#: templates/report.html.j2:141
