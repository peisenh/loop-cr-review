msgstr "sehr niedrig"

#: templates/report.html.j2:263
msgid "low"
msgstr "niedrig"

#: templates/report.html.j2:263
msgid "medium"
msgstr "mittel"

#: templates/report.html.j2:263
msgid "high"
msgstr "hoch"

#: templates/report.html.j2:263
