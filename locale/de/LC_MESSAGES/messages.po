#: lcr/analysis.py:77
msgid "Low risk"
msgstr "niedriges Risiko"

#: lcr/analysis.py:79
msgid "Low to moderate risk"
msgstr "niedriges bis moderates Risiko"

#: lcr/analysis.py:81
msgid "Moderate risk"
msgstr "mittleres Risiko"

#: lcr/analysis.py:83
msgid "High risk"
msgstr "hohes Risiko"

#: lcr/analysis.py:85
msgid "Very high risk"
msgstr "sehr hohes Risiko"

#: lcr/analysis.py:304 templates/report.html.j2:296
msgid "too weak → tighten"
msgstr "zu schwach → straffen"

#: lcr/analysis.py:305 templates/report.html.j2:296
msgid "too strong → loosen"
msgstr "zu stark → lockern"

#: lcr/analysis.py:306 templates/report.html.j2:296
msgid "plausibly adequate"
msgstr "plausibel passend"

#: lcr/analysis.py:315
msgid " ⚠︎ (hypo treated)"
msgstr " ⚠︎ (Hypo behandelt)"

#: lcr/analysis.py:318
msgid " ⚠︎ (hypo rescue — likely too strong)"
msgstr " ⚠︎ (Hypo-Behandlung — wahrscheinlich zu stark)"

#: lcr/analysis.py:321
msgid " ⚠︎ (isolated hypo(s) — mixed, check meals individually)"
msgstr " ⚠︎ (vereinzelte Hypo(s) — uneinheitlich, Mahlzeiten einzeln prüfen)"

#: lcr/analysis.py:327
msgid " ⚠︎ (few clean meals)"
msgstr " ⚠︎ (wenig saubere Mahlzeiten)"

#: lcr/analysis.py:339
msgid "rises and then falls to low values"
msgstr "steigt an und fällt anschließend in tiefe Werte"

#: lcr/analysis.py:341 lcr/analysis.py:464
msgid "climbs and does not return to baseline"
msgstr "klettert und kehrt nicht zum Ausgangswert zurück"

#: lcr/analysis.py:343
msgid "falls clearly below baseline"
msgstr "fällt deutlich unter den Ausgangswert"

#: lcr/analysis.py:344 lcr/analysis.py:469
msgid "returns close to baseline (balanced)"
msgstr "kehrt nahe zum Ausgangswert zurück (ausgewogen)"

#: lcr/analysis.py:360 lcr/analysis.py:370 lcr/analysis.py:390
#: lcr/analysis.py:395 lcr/analysis.py:397 lcr/analysis.py:402
#: lcr/analysis.py:404
msgid "Caution"
msgstr "Achtung"

#: lcr/analysis.py:361
msgid ""
"BG clearly elevated at the end of the window, but the loop rather "
"throttled (contradictory signal) → possibly an outlier/small sample size "
"rather than a CR problem; check individual meals before tightening"
msgstr ""
"BZ am Fensterende deutlich erhöht, aber Loop hat eher gedrosselt "
"(widersprüchliches Signal) → möglicherweise Ausreißer/geringe Fallzahl "
"statt CR-Problem; vor Straffen Einzelmahlzeiten prüfen"

#: lcr/analysis.py:364 lcr/analysis.py:417
msgid "Dose"
msgstr "Dosis"

#: lcr/analysis.py:365
#, python-format
msgid "underdosed → tighten CR, rough direction CR_eff %(cre)s"
msgstr "unterdeckt → CR straffen, grobe Richtung CR_eff %(cre)s"

#: lcr/analysis.py:371
#, python-format
msgid ""
"Δ%(h)dh is negative (BG fell at the end); the verdict here rests solely "
"on the strong loop extra basal — the loop caught the too-weak CR. Before "
"tightening, check individual meals and contamination"
msgstr ""
"Δ%(h)dh ist negativ (BZ am Ende gefallen), der Befund stützt sich hier "
"allein auf das kräftige Loop-Mehrbasal — der Loop hat die zu schwache CR "
"aufgefangen. Vor dem Straffen Einzelmahlzeiten und Kontamination prüfen"

#: lcr/analysis.py:390
#, python-format
msgid "nadir ~%(n).0f %(u)s around %(t)d min → secure the hypo window first"
msgstr "Tief ~%(n).0f %(u)s gegen %(t)d min → Hypo-Fenster zuerst absichern"

#: lcr/analysis.py:395
#, python-format
msgid ""
"nadir ~%(n).0f %(u)s around %(t)d min — a hypo occurred and was treated; "
"reduce the dose here"
msgstr ""
"Tief ~%(n).0f %(u)s gegen %(t)d min — eine Hypo trat auf und wurde "
"behandelt; Dosis hier reduzieren"

#: lcr/analysis.py:397
#, python-format
msgid ""
"nadir ~%(n).0f %(u)s around %(t)d min — a hypo occurred and was treated "
"on one meal; check that meal, do not tighten the whole slot"
msgstr ""
"Tief ~%(n).0f %(u)s gegen %(t)d min — eine Hypo trat auf und wurde bei "
"einer Mahlzeit behandelt; diese Mahlzeit prüfen, nicht den ganzen Slot "
"straffen"

#: lcr/analysis.py:402
msgid "a hypo occurred and was treated in the window; reduce the dose here"
msgstr "im Fenster trat eine Hypo auf und wurde behandelt; Dosis hier reduzieren"

#: lcr/analysis.py:404
msgid ""
"a hypo occurred and was treated on one meal; check that meal, do not "
"tighten the whole slot"
msgstr ""
"bei einer Mahlzeit trat eine Hypo auf und wurde behandelt; diese Mahlzeit"
" prüfen, nicht den ganzen Slot straffen"

#: lcr/analysis.py:412
msgid "Pre-bolus"
msgstr "SEA"

#: lcr/analysis.py:412
msgid ""
"early high peak → try a longer bolus-meal interval (caps the spike "
"without more dose)"
msgstr ""
"früher hoher Peak → längeren Spritz-Ess-Abstand prüfen (kappt die Spitze "
"ohne mehr Dosis)"

#: lcr/analysis.py:417
msgid ""
"overdosed/drop → rather reduce the dose of this meal; consider pre-bolus "
"and dose together"
msgstr ""
"überdeckt/Abfall → Dosis dieser Mahlzeit eher reduzieren; SEA und Dosis "
"zusammen betrachten"

#: lcr/analysis.py:421
msgid "Fat/protein"
msgstr "Fett/Protein"

#: lcr/analysis.py:421
msgid ""
"monotonic late rise (no turning point) → check fat/protein; possibly "
"delayed/dual bolus instead of only tightening"
msgstr ""
"monotoner Spätanstieg (kein Umkehrpunkt) → Fett/Protein prüfen; ggf. "
"verzögerter/Dual-Bolus statt nur straffen"

#: lcr/analysis.py:424
msgid "Observe"
msgstr "Beobachten"

#: lcr/analysis.py:424
msgid ""
"slight late re-rise → possibly fat/protein or basal rate in this window; "
"just keep an eye on it"
msgstr ""
"leichter später Wiederanstieg → ggf. Fett/Protein oder Basalrate in "
"diesem Zeitfenster, nur im Auge behalten"

#: lcr/analysis.py:434
msgid "no notable shape"
msgstr "keine auffällige Form"

#: lcr/analysis.py:444 lcr/analysis.py:447 lcr/analysis.py:449
msgid "Reference"
msgstr "Referenz"

#: lcr/analysis.py:444
msgid ""
"CR on average fits, but a meal went low (hypo rescue) — check that one, "
"do not tighten"
msgstr ""
"CR im Mittel passend, aber eine Mahlzeit ging tief (Hypo-Behandlung) — "
"diese prüfen, nicht straffen"

#: lcr/analysis.py:447
msgid "dose fits — leave as is; for timing see the pre-bolus note above"
msgstr "Dosis passt — so belassen; Timing siehe SEA-Hinweis oben"

#: lcr/analysis.py:449
msgid ""
"dose & timing fit — leave as is; serves as a comparison for the other "
"slots"
msgstr ""
"Dosis & Timing passen — so belassen; dient als Vergleich für die anderen "
"Slots"

#: lcr/analysis.py:459
msgid "high peak, then drop below baseline"
msgstr "hoher Peak, danach Abfall unter die Ausgangslage"

#: lcr/analysis.py:460
msgid "falls below baseline"
msgstr "fällt unter den Ausgangswert"

#: lcr/analysis.py:462
msgid "returns close to baseline, loop throttles noticeably"
msgstr "kehrt nahe zum Ausgangswert zurück, Loop drosselt spürbar"

#: lcr/analysis.py:466
msgid "slight late rise, but net balanced"
msgstr "leichter Spätanstieg, netto aber ausgewogen"

#: lcr/analysis.py:468
msgid "early peak, then returns cleanly"
msgstr "früher Peak, kehrt anschließend sauber zurück"

#: lcr/analysis.py:487
#, python-format
msgid ""
"• Derived CR = CHO/bolus; no slot deviates notably from the median "
"(1:%(m).1f).<br>"
msgstr ""
"• Abgeleitete CR = CHO/Bolus; kein Slot weicht auffällig vom Median "
"(1:%(m).1f) ab.<br>"

#: lcr/analysis.py:491
msgid "tighter"
msgstr "straffer"

#: lcr/analysis.py:491
msgid "looser"
msgstr "lockerer"

#: lcr/analysis.py:493
msgid ""
"elevated pre-meal BG → correction likely blended in by the calculator, "
"derived CR underestimates the programmed ratio"
msgstr ""
"erhöhter prä-BZ → vom Rechner beigemischte Korrektur wahrscheinlich, "
"abgeleitete CR unterschätzt die programmierte Ratio"

#: lcr/analysis.py:496
msgid ""
"pre-meal BG not clearly elevated → rather a genuinely different "
"programmed ratio than a pure correction"
msgstr ""
"prä-BZ nicht deutlich erhöht → eher genuin andere programmierte Ratio als"
" reine Korrektur"

#: lcr/analysis.py:498
#, python-format
msgid ""
"%(slot)s: derived CR 1:%(scr).1f (%(dir)s than median 1:%(m).1f), pre-"
"meal BG ~%(bg).0f %(u)s – %(hint)s"
msgstr ""
"%(slot)s: abgeleitete CR 1:%(scr).1f (%(dir)s als Median 1:%(m).1f), "
"prä-BZ ~%(bg).0f %(u)s – %(hint)s"

#: lcr/analysis.py:502
msgid ""
"• Derived CR = CHO/bolus (may include blended-in corrections). Notable "
"deviations: "
msgstr ""
"• Abgeleitete CR = CHO/Bolus (enthält ggf. beigemischte Korrekturen). "
"Auffällige Abweichungen: "

#: lcr/analysis.py:503
msgid ""
". Clarification (programmed ratio vs. correction factor vs. timing) by "
"the care team.<br>"
msgstr ""
". Klärung (programmierte Ratio vs. Korrekturfaktor vs. Timing) durch das "
"Team.<br>"

