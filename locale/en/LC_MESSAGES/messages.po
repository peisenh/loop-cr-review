"    report draws no conclusion from them."

#: templates/report.html.j2:410
#, python-format
msgid ""
"<b>Method:</b> <b>CR (CHO/bolus)</b> = CHO / meal bolus only (it\n"
"    may contain correction insulin). Δ%(w)s = glucose at %(w)s minus pre-meal — with "
"no basal in\n"
"    the export the verdict rests on this return alone. \"clean\" = meals without "
"another meal in the\n"
"    %(w)s window and without a large CGM gap."
msgstr ""
"<b>Method:</b> <b>CR (CHO/bolus)</b> = CHO / meal bolus only (it\n"
"    may contain correction insulin). Δ%(w)s = glucose at %(w)s minus pre-meal — with "
"no basal in\n"
"    the export the verdict rests on this return alone. \"clean\" = meals without "
"another meal in the\n"
"    %(w)s window and without a large CGM gap."

#: templates/report.html.j2:414
#, python-format
msgid ""
"<b>Method:</b> Loop %(w)s = basal delivered by Auto Mode in addition to the\n"
"    fasting basal rate. <b>CR (CHO/bolus)</b> = CHO / meal bolus only (not the pump’s"
" programmed ICR).\n"
"    <b>CR_eff (+loop)</b> = CHO / (bolus + loop extra basal). Δ%(w)s = glucose at\n"
"    %(w)s minus pre-meal. \"clean\" = meals without another meal in the %(w)s window "
"and without a\n"
"    large CGM gap."
msgstr ""
"<b>Method:</b> Loop %(w)s = basal delivered by Auto Mode in addition to the\n"
"    fasting basal rate. <b>CR (CHO/bolus)</b> = CHO / meal bolus only (not the pump’s"
" programmed ICR).\n"
"    <b>CR_eff (+loop)</b> = CHO / (bolus + loop extra basal). Δ%(w)s = glucose at\n"
"    %(w)s minus pre-meal. \"clean\" = meals without another meal in the %(w)s window "
"and without a\n"
"    large CGM gap."

