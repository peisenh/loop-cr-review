#: templates/report.html.j2:208
#, python-format
msgid ""
"in the %(w)s window. Positive → the loop is compensating for a too-weak CR\n"
"    (CR too weak). <b>CR (CHO/bolus)</b> = CHO / meal bolus only (not the pump’s programmed ICR)."
"\n"
"    <b>CR_eff (+loop)</b> = CHO / (bolus + loop extra basal). Δ%(w)s = glucose at\n"
"    %(w)s minus pre-meal. \"clean\" = meals without another meal in the %(w)s window and without "
"a large CGM gap."
msgstr ""
"in the %(w)s window. Positive → the loop is compensating for a too-weak CR\n"
"    (CR too weak). <b>CR (CHO/bolus)</b> = CHO / meal bolus only (not the pump’s programmed ICR)."
"\n"
"    <b>CR_eff (+loop)</b> = CHO / (bolus + loop extra basal). Δ%(w)s = glucose at\n"
"    %(w)s minus pre-meal. \"clean\" = meals without another meal in the %(w)s window."

#: templates/report.html.j2:212
